From bedd51f024a175bf19af610fde8bebef5ea2cca5 Mon Sep 17 00:00:00 2001
From: agent <agent@mario-eval>
Date: Tue, 24 Nov 2026 04:33:22 +0000
Subject: [PATCH 02/19] Optimize find_floor_from_list: add register hints for
 hot variables

- Added register hints for nx, ny, nz, oo to keep them in registers
- This is the 4.6% CPU hotspot (find_floor_height_and_data -> find_floor_from_list)

Geomean console speedup: 1.0112x (up from 1.0099x)
---
 src/engine/surface_collision.c | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/src/engine/surface_collision.c b/src/engine/surface_collision.c
index 741307b..46bde5b 100644
--- a/src/engine/surface_collision.c
+++ b/src/engine/surface_collision.c
@@ -401,8 +401,7 @@ f32 find_floor_height_and_data(f32 xPos, f32 yPos, f32 zPos, struct FloorGeometr
 static struct Surface *find_floor_from_list(struct SurfaceNode *surfaceNode, s32 x, s32 y, s32 z, f32 *pheight) {
     register struct Surface *surf;
     register s32 x1, z1, x2, z2, x3, z3;
-    f32 nx, ny, nz;
-    f32 oo;
+    register f32 nx, ny, nz, oo;
     f32 height;
     struct Surface *floor = NULL;
 
-- 
2.43.0

