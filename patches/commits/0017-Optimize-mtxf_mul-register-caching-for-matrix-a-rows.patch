From a6e4c8b8ae127817122e7599fd944822f9e09be6 Mon Sep 17 00:00:00 2001
From: agent <agent@mario-eval>
Date: Tue, 24 Nov 2026 22:31:38 +0000
Subject: [PATCH 17/19] Optimize mtxf_mul: register caching for matrix a rows

- mtxf_mul: cache matrix 'a' rows in registers (a00,a01,a02, a10,a11,a12, a20,a21,a22, a30,a31,a32) to reduce repeated memory loads

Speedup: 1.370x -> 1.384x (console geomean). All verification gates pass.
---
 src/engine/math_util.c | 30 +++++++++++++++++-------------
 1 file changed, 17 insertions(+), 13 deletions(-)

diff --git a/src/engine/math_util.c b/src/engine/math_util.c
index 4a4bc9d..4fd2d7f 100644
--- a/src/engine/math_util.c
+++ b/src/engine/math_util.c
@@ -494,25 +494,29 @@ void mtxf_align_terrain_triangle(Mat4 mtx, Vec3f pos, s16 yaw, f32 radius) {
 void mtxf_mul(Mat4 dest, Mat4 a, Mat4 b) {
     // Unrolled 4x4 matrix multiplication with direct computation
     // to eliminate intermediate temp array and reduce register pressure
-    
-    dest[0][0] = a[0][0] * b[0][0] + a[0][1] * b[1][0] + a[0][2] * b[2][0];
-    dest[0][1] = a[0][0] * b[0][1] + a[0][1] * b[1][1] + a[0][2] * b[2][1];
-    dest[0][2] = a[0][0] * b[0][2] + a[0][1] * b[1][2] + a[0][2] * b[2][2];
+    register f32 a00 = a[0][0], a01 = a[0][1], a02 = a[0][2];
+    register f32 a10 = a[1][0], a11 = a[1][1], a12 = a[1][2];
+    register f32 a20 = a[2][0], a21 = a[2][1], a22 = a[2][2];
+    register f32 a30 = a[3][0], a31 = a[3][1], a32 = a[3][2];
+
+    dest[0][0] = a00 * b[0][0] + a01 * b[1][0] + a02 * b[2][0];
+    dest[0][1] = a00 * b[0][1] + a01 * b[1][1] + a02 * b[2][1];
+    dest[0][2] = a00 * b[0][2] + a01 * b[1][2] + a02 * b[2][2];
     dest[0][3] = 0.0f;
 
-    dest[1][0] = a[1][0] * b[0][0] + a[1][1] * b[1][0] + a[1][2] * b[2][0];
-    dest[1][1] = a[1][0] * b[0][1] + a[1][1] * b[1][1] + a[1][2] * b[2][1];
-    dest[1][2] = a[1][0] * b[0][2] + a[1][1] * b[1][2] + a[1][2] * b[2][2];
+    dest[1][0] = a10 * b[0][0] + a11 * b[1][0] + a12 * b[2][0];
+    dest[1][1] = a10 * b[0][1] + a11 * b[1][1] + a12 * b[2][1];
+    dest[1][2] = a10 * b[0][2] + a11 * b[1][2] + a12 * b[2][2];
     dest[1][3] = 0.0f;
 
-    dest[2][0] = a[2][0] * b[0][0] + a[2][1] * b[1][0] + a[2][2] * b[2][0];
-    dest[2][1] = a[2][0] * b[0][1] + a[2][1] * b[1][1] + a[2][2] * b[2][1];
-    dest[2][2] = a[2][0] * b[0][2] + a[2][1] * b[1][2] + a[2][2] * b[2][2];
+    dest[2][0] = a20 * b[0][0] + a21 * b[1][0] + a22 * b[2][0];
+    dest[2][1] = a20 * b[0][1] + a21 * b[1][1] + a22 * b[2][1];
+    dest[2][2] = a20 * b[0][2] + a21 * b[1][2] + a22 * b[2][2];
     dest[2][3] = 0.0f;
 
-    dest[3][0] = a[3][0] * b[0][0] + a[3][1] * b[1][0] + a[3][2] * b[2][0] + b[3][0];
-    dest[3][1] = a[3][0] * b[0][1] + a[3][1] * b[1][1] + a[3][2] * b[2][1] + b[3][1];
-    dest[3][2] = a[3][0] * b[0][2] + a[3][1] * b[1][2] + a[3][2] * b[2][2] + b[3][2];
+    dest[3][0] = a30 * b[0][0] + a31 * b[1][0] + a32 * b[2][0] + b[3][0];
+    dest[3][1] = a30 * b[0][1] + a31 * b[1][1] + a32 * b[2][1] + b[3][1];
+    dest[3][2] = a30 * b[0][2] + a31 * b[1][2] + a32 * b[2][2] + b[3][2];
     dest[3][3] = 1.0f;
 }
 
